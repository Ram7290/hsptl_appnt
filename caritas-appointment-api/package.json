{
  "name": "caritas-appointment-api",
  "version": "1.0.0",
  "description": "Concurrent appointment booking API for Caritas Hospital (Node.js + Express + SQL Server with pessimistic locking)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "concurrency:2": "node scripts/concurrentTest.js 101 2",
    "concurrency:5": "node scripts/concurrentTest.js 101 5",
    "concurrency:10": "node scripts/concurrentTest.js 101 10"
  },
  "keywords": [
    "express",
    "mssql",
    "sql-server",
    "concurrency",
    "appointments"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9"
  }
}
